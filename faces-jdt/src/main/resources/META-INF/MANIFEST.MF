Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Faces Language Server jdtls bundle
Bundle-SymbolicName: io.github.jungm.fls.jdt;singleton:=true
Bundle-Version: ${bundle.version}
Bundle-Vendor: Faces Language Server
Bundle-Activator: io.github.jungm.fls.jdt.FacesJdtActivator
Bundle-RequiredExecutionEnvironment: JavaSE-21
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.jdt.core,
 com.google.gson,
 org.eclipse.jdt.ls.core;resolution:=optional,
 org.eclipse.lsp4j;resolution:=optional,
 org.eclipse.lsp4j.jsonrpc;resolution:=optional
Export-Package: io.github.jungm.fls.jdt
